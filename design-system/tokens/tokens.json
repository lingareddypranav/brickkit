{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "orange-1": { "$type": "color", "$value": "#F85F19", "$description": "Figma orange1. Accent / CTA only." },
    "blue-1": { "$type": "color", "$value": "#3860E5", "$description": "Figma blue1. Brand / blueprint." },
    "dark-1": { "$type": "color", "$value": "#2F2F2F", "$description": "Figma dark1. Charcoal." },
    "light-1": { "$type": "color", "$value": "#F6F4EB", "$description": "Figma light1. Cream paper." },
    "muted-1": { "$type": "color", "$value": "color-mix(in srgb, {color.dark-1} 64%, {color.light-1})", "$description": "dark1 at 64% on cream. Captions and secondary type." }
  },
  "semantic": {
    "color": {
      "bg": { "$type": "color", "$value": "{color.light-1}" },
      "bg-inverse": { "$type": "color", "$value": "{color.dark-1}" },
      "bg-brand": { "$type": "color", "$value": "{color.blue-1}" },
      "bg-accent": { "$type": "color", "$value": "{color.orange-1}" },
      "fg": { "$type": "color", "$value": "{color.dark-1}" },
      "fg-muted": { "$type": "color", "$value": "{color.muted-1}" },
      "fg-on-inverse": { "$type": "color", "$value": "{color.light-1}" },
      "brand": { "$type": "color", "$value": "{color.blue-1}" },
      "accent": { "$type": "color", "$value": "{color.orange-1}" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Host Grotesk" },
    "tracking": { "$type": "dimension", "$value": "-1%" },
    "tracking-wordmark": { "$type": "dimension", "$value": "0%" },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "ui": { "$type": "dimension", "$value": "16px" },
      "body": { "$type": "dimension", "$value": "20px", "$description": "Figma body: Host Grotesk Regular 20pt −1%" },
      "h3": { "$type": "dimension", "$value": "24px" },
      "h2": { "$type": "dimension", "$value": "32px" },
      "h1": { "$type": "dimension", "$value": "48px" },
      "display": { "$type": "dimension", "$value": "64px" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "16px" },
    "4": { "$type": "dimension", "$value": "24px" },
    "5": { "$type": "dimension", "$value": "32px" },
    "6": { "$type": "dimension", "$value": "40px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "80px" },
    "10": { "$type": "dimension", "$value": "96px" },
    "11": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "ui-sm": { "$type": "dimension", "$value": "8px" },
    "ui-md": { "$type": "dimension", "$value": "16px" },
    "ui-lg": { "$type": "dimension", "$value": "24px" },
    "brick": { "$type": "dimension", "$value": "12px", "$description": "Figma brick union radius" }
  },
  "logo": {
    "mark-height": { "$type": "dimension", "$value": "80px", "$description": "Full 2-wide brick height including studs" },
    "tile-from-brick": { "$value": 1.7778, "$description": "400/225 — Figma square around the same brick" },
    "tile-radius": { "$value": 0.05, "$description": "20/400" },
    "body-ratio": { "$value": 0.7778, "$description": "175/225 — wordmark B matches this band" },
    "cap-height": { "$value": 0.7, "$description": "Host Grotesk B / em" },
    "gap": { "$type": "dimension", "$value": "16px" }
  },
  "brick": {
    "unit": { "$type": "dimension", "$value": "150px" },
    "height": { "$type": "dimension", "$value": "225px" },
    "body": { "$type": "dimension", "$value": "175px" },
    "stud-width": { "$type": "dimension", "$value": "90px" },
    "stud-height": { "$type": "dimension", "$value": "50px" },
    "tick": { "$type": "dimension", "$value": "25px" }
  }
}
